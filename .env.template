# Environment Variables Template for QNN Financial Markets
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# QuantConnect API Configuration (REQUIRED)
QUANTCONNECT_API_KEY=YOUR_API_KEY_HERE
QUANTCONNECT_API_SECRET=YOUR_API_SECRET_HERE
QUANTCONNECT_USER_ID=YOUR_USER_ID_HERE

# Trading Parameters
INITIAL_CASH=100000
START_DATE=2024-01-01
END_DATE=2025-01-01
TARGET_SYMBOL=SPY

# Quantum Circuit Parameters
NUM_QUBITS=2
TRAINING_ITERATIONS=200
LEARNING_RATE=0.05
QUANTUM_SHOTS=1024

# Risk Management
MAX_POSITION_SIZE=1.0
STOP_LOSS_PERCENTAGE=0.05
TAKE_PROFIT_PERCENTAGE=0.10

# Model Parameters
TRAINED_PARAMETERS_FILE=trained_parameters.npy

# Logging and Monitoring
LOG_LEVEL=INFO
ENABLE_DETAILED_LOGGING=true
SAVE_TRADING_LOGS=true
SAVE_BACKTEST_RESULTS=true